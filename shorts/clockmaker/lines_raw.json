[
 {
  "i": 0,
  "text": "У маленькому містечку жив старий годинникар.",
  "s": 0.0,
  "e": 2.60989,
  "at": 0.25
 },
 {
  "i": 1,
  "text": "Його звали Еліас.",
  "s": 3.25853,
  "e": 4.69116,
  "at": 3.41
 },
 {
  "i": 2,
  "text": "Кожен годинник у його крамниці йшов назад.",
  "s": 5.3354,
  "e": 7.79633,
  "at": 5.39
 },
 {
  "i": 3,
  "text": "Люди сміялися…",
  "s": 8.46923,
  "e": 9.56596,
  "at": 8.4
 },
 {
  "i": 4,
  "text": "…доки не помітили дивну річ.",
  "s": 10.002,
  "e": 11.6524,
  "at": 10.25
 },
 {
  "i": 5,
  "text": "Кожен годинник мав ім'я.",
  "s": 12.3259,
  "e": 13.8089,
  "at": 12.45
 },
 {
  "i": 6,
  "text": "Ім'я когось із мешканців міста.",
  "s": 14.5696,
  "e": 16.6698,
  "at": 15.25
 },
 {
  "i": 7,
  "text": "Коли стрілки зупинялись на нулі…",
  "s": 17.3668,
  "e": 19.2083,
  "at": 17.9
 },
 {
  "i": 8,
  "text": "…ця людина зникала.",
  "s": 19.8834,
  "e": 20.9543,
  "at": 20.29
 },
 {
  "i": 9,
  "text": "Одного вечора до крамниці зайшла дівчинка Ліна.",
  "s": 21.7259,
  "e": 24.3698,
  "at": 22.25
 },
 {
  "i": 10,
  "text": "Вона шукала годинник для бабусі.",
  "s": 25.0375,
  "e": 26.7952,
  "at": 25.44
 },
 {
  "i": 11,
  "text": "Еліас зблід.",
  "s": 27.5944,
  "e": 28.7534,
  "at": 27.75
 },
 {
  "i": 12,
  "text": "На полиці цокав годинник з ім'ям її бабусі.",
  "s": 29.5452,
  "e": 32.0956,
  "at": 30.25
 },
 {
  "i": 13,
  "text": "Лишалась одна хвилина.",
  "s": 32.806,
  "e": 34.0575,
  "at": 33.35
 },
 {
  "i": 14,
  "text": "Ліна схопила годинник і побігла.",
  "s": 34.6123,
  "e": 36.5118,
  "at": 35.25
 },
 {
  "i": 15,
  "text": "Крізь туман, крізь темні вулиці…",
  "s": 37.0707,
  "e": 39.5844,
  "at": 37.7
 },
 {
  "i": 16,
  "text": "Стрілки бігли все швидше.",
  "s": 40.143,
  "e": 41.5578,
  "at": 40.76
 },
 {
  "i": 17,
  "text": "Тридцять секунд.",
  "s": 42.0906,
  "e": 42.9153,
  "at": 42.73
 },
 {
  "i": 18,
  "text": "Вона влетіла в дім.",
  "s": 43.4739,
  "e": 44.5079,
  "at": 45.25
 },
 {
  "i": 19,
  "text": "Бабуся сиділа біля вікна.",
  "s": 45.0879,
  "e": 46.47,
  "at": 47.25
 },
 {
  "i": 20,
  "text": "Десять секунд.",
  "s": 47.0294,
  "e": 47.8259,
  "at": 50.25
 },
 {
  "i": 21,
  "text": "Ліна обійняла її…",
  "s": 48.3532,
  "e": 49.3533,
  "at": 52.25
 },
 {
  "i": 22,
  "text": "…і щосили стиснула годинник у долонях.",
  "s": 49.8681,
  "e": 51.8265,
  "at": 55.25
 },
 {
  "i": 23,
  "text": "Скло тріснуло.",
  "s": 52.3705,
  "e": 53.1775,
  "at": 57.76
 },
 {
  "i": 24,
  "text": "Стрілки зупинились на одній секунді.",
  "s": 53.706,
  "e": 55.5817,
  "at": 60.25
 },
 {
  "i": 25,
  "text": "Тиша.",
  "s": 56.2339,
  "e": 56.6056,
  "at": 63.43
 },
 {
  "i": 26,
  "text": "А потім — цок.",
  "s": 57.2654,
  "e": 58.4432,
  "at": 65.25
 },
 {
  "i": 27,
  "text": "Стрілки пішли вперед.",
  "s": 59.4438,
  "e": 60.5801,
  "at": 67.25
 },
 {
  "i": 28,
  "text": "Вперше за сто років.",
  "s": 61.4396,
  "e": 62.4931,
  "at": 70.25
 },
 {
  "i": 29,
  "text": "Наступного ранку крамниця зникла.",
  "s": 63.3773,
  "e": 65.0926,
  "at": 72.25
 },
 {
  "i": 30,
  "text": "На її місці лишився лише пил…",
  "s": 65.623,
  "e": 67.2952,
  "at": 75.25
 },
 {
  "i": 31,
  "text": "…і записка: «Час не можна вкрасти. Його можна лише подарувати».",
  "s": 68.0136,
  "e": 72.6181,
  "at": 77.47
 },
 {
  "i": 32,
  "text": "Ліна відкрила долоню.",
  "s": 73.3924,
  "e": 74.6608,
  "at": 82.63
 },
 {
  "i": 33,
  "text": "На склі годинника тепер було її ім'я.",
  "s": 75.0034,
  "e": 77.1794,
  "at": 84.45
 },
 {
  "i": 34,
  "text": "І він ішов назад.",
  "s": 78.1379,
  "e": 79.0068,
  "at": 87.17
 },
 {
  "i": 35,
  "text": "Підпишись, щоб дізнатися, скільки часу лишилось у тебе.",
  "s": 80.05,
  "e": 83.1241,
  "at": 88.59
 }
]