[
{
"i": 0,
"text": "На краю міста стояла крамниця дзеркал.",
"at": 0.25,
"dur": 1.65
},
{
"i": 1,
"text": "Її власник, майстер Вейл, ніколи не виходив на вулицю.",
"at": 2.25,
"dur": 2.65
},
{
"i": 2,
"text": "Усі його дзеркала мали одну дивну ваду.",
"at": 5.25,
"dur": 1.65
},
{
"i": 3,
"text": "Відображення запізнювалось на секунду.",
"at": 7.25,
"dur": 2.65
},
{
"i": 4,
"text": "Покупці сміялися й купували їх.",
"at": 10.25,
"dur": 1.65
},
{
"i": 5,
"text": "Ніхто не помічав, що вони виходили… трохи інакшими.",
"at": 12.25,
"dur": 2.65
},
{
"i": 6,
"text": "Одного вечора до крамниці забіг хлопчик Тим.",
"at": 15.25,
"dur": 1.65
},
{
"i": 7,
"text": "Він просто ховався від дощу.",
"at": 17.25,
"dur": 2.2825
},
{
"i": 8,
"text": "У кутку стояло старе високе дзеркало.",
"at": 20.25,
"dur": 1.65
},
{
"i": 9,
"text": "Тим махнув рукою… а відображення — ні.",
"at": 22.25,
"dur": 2.65
},
{
"i": 10,
"text": "А потім воно постукало зсередини.",
"at": 25.25,
"dur": 1.65
},
{
"i": 11,
"text": "Хлопчик у дзеркалі показав папірець.",
"at": 27.25,
"dur": 2.65
},
{
"i": 12,
"text": "«Я справжній. Тікай».",
"at": 30.25,
"dur": 1.5675000000000001
},
{
"i": 13,
"text": "За спиною скрипнула підлога.",
"at": 32.25,
"dur": 2.25
},
{
"i": 14,
"text": "У майстра Вейла не було відображення.",
"at": 35.25,
"dur": 1.65
},
{
"i": 15,
"text": "«Подивись уважніше», — прошепотів він.",
"at": 37.25,
"dur": 2.5749999999999997
},
{
"i": 16,
"text": "У дзеркалах були люди.",
"at": 40.25,
"dur": 1.65
},
{
"i": 17,
"text": "Справжні мешканці міста.",
"at": 42.25,
"dur": 1.9575
},
{
"i": 18,
"text": "А вулицями ходили їхні відображення.",
"at": 45.25,
"dur": 1.65
},
{
"i": 19,
"text": "Вейл простягнув руку до хлопчика.",
"at": 47.25,
"dur": 2.6075
},
{
"i": 20,
"text": "Тим схопив стілець…",
"at": 50.25,
"dur": 1.6325
},
{
"i": 21,
"text": "…і щосили вдарив у дзеркало.",
"at": 52.25,
"dur": 2.2175
},
{
"i": 22,
"text": "Скло розлетілося на тисячі уламків.",
"at": 55.25,
"dur": 1.65
},
{
"i": 23,
"text": "І в кожному уламку був хтось живий.",
"at": 57.25,
"dur": 2.65
},
{
"i": 24,
"text": "Тиша.",
"at": 60.25,
"dur": 0.6575
},
{
"i": 25,
"text": "А потім тріснули всі дзеркала разом.",
"at": 62.25,
"dur": 2.65
},
{
"i": 26,
"text": "Люди виходили зі скла, як із води.",
"at": 65.25,
"dur": 1.65
},
{
"i": 27,
"text": "А Вейл розсипався срібним пилом.",
"at": 67.25,
"dur": 2.5425
},
{
"i": 28,
"text": "Тим біг додому, а місто оживало.",
"at": 70.25,
"dur": 1.65
},
{
"i": 29,
"text": "Мама чекала на порозі.",
"at": 72.25,
"dur": 1.86
},
{
"i": 30,
"text": "«Де ти був так довго, сонечко?»",
"at": 75.25,
"dur": 1.65
},
{
"i": 31,
"text": "Тим глянув у дзеркало в коридорі.",
"at": 77.25,
"dur": 2.6399999999999997
},
{
"i": 32,
"text": "Мама в дзеркалі його не обіймала.",
"at": 80.25,
"dur": 1.65
},
{
"i": 33,
"text": "Вона стукала по склу.",
"at": 82.25,
"dur": 1.7950000000000002
},
{
"i": 34,
"text": "А мама поруч усміхнулася… трохи ширше.",
"at": 85.25,
"dur": 1.65
},
{
"i": 35,
"text": "Підпишись… і не дивись у дзеркало надто довго.",
"at": 87.25,
"dur": 2.65
}
]